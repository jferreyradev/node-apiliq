# ==============================================================================
# CONFIGURACIÓN ESENCIAL DE LA API (node-apiliq)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y ajusta los valores:
#   cp .env.example .env
# ==============================================================================

# 1. Conexión a Base de Datos Oracle (Obligatorio)
USERDB="<USUARIO_ORACLE>"
PASSWORD="<PASSWORD_ORACLE>"
# Formato: host:puerto/servicio (ejemplo: 192.168.1.X:1521/ORCL)
CONNECTIONSTRING="<HOST_ORACLE>:<PUERTO>/<SERVICIO>"

# 2. Seguridad Administrativa (Obligatorio)
# Protege endpoints críticos (/api/admin/*, /api/view/save, /api/import/*, /api/sql/execute)
# Se envía vía cabecera: X-Admin-Key: <clave>
ADMIN_ACCESS_KEY="<TU_CLAVE_ADMIN_AQUI>"

# 3. Seguridad de Datos para Clientes y Frontends (Opcional)
# Activa la protección obligatoria para todas las consultas (/api/view/*, /api/sp/*)
# REQUIRE_AUTH=true requiere que la petición envíe X-API-Key, X-Admin-Key o Bearer <JWT>
# En 'false' (por defecto), permite acceso abierto para desarrollo local e intranet legacy.
REQUIRE_AUTH=false
API_CLIENT_KEY="<CLAVE_SECRETA_PARA_FRONTENDS>"
JWT_SECRET="<SECRETO_PARA_FIRMAR_Y_VERIFICAR_TOKENS_JWT>"

# 4. Restricción de Orígenes CORS (Opcional, por defecto '*' abierto)
# Limita qué dominios pueden hacer peticiones desde navegadores
# CORS_WHITELIST=https://mi-frontend.com,https://api-rpi.liqsysonline.com,http://localhost:5173

# 5. Servidor Web (Opcional, por defecto: 3005)
PORT=3005

# 6. Instant Client (Opcional: descomentar solo si las librerías están en una carpeta local)
# ORACLE_CLIENT_LIB_DIR=./oracle-client/instantclient_23_3
