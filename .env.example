# ==============================================================================
# CONFIGURACIÓN ESENCIAL DE LA API (node-apiliq)
# ==============================================================================
# Para configurar tu entorno:
#   1. Copia este archivo: cp .env.example .env
#   2. Reemplaza los valores entre <...> con tus datos reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXIÓN A BASE DE DATOS ORACLE (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Usuario del esquema de liquidación en Oracle (ejemplo: US_SUELDO)
USERDB="<USUARIO_ORACLE>"

# Contraseña del usuario Oracle
PASSWORD="<PASSWORD_ORACLE>"

# Cadena de conexión a Oracle con formato host:puerto/servicio
# Ejemplo en red local: 192.168.1.50:1521/ORCL
# Ejemplo con SID: 192.168.1.50:1521:XE
CONNECTIONSTRING="<HOST_ORACLE>:<PUERTO>/<SERVICIO>"


# ------------------------------------------------------------------------------
# 2. SEGURIDAD ADMINISTRATIVA (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Clave Maestra (Root) para tareas críticas del sistema.
# Protege: /api/admin/*, /api/view/save, /api/import/*, /api/sql/execute, /sp/sync-oracle
# Se envía desde el panel api-liq-admin o cURL vía cabecera: X-Admin-Key: <clave>
ADMIN_ACCESS_KEY="<TU_CLAVE_ADMIN_AQUI>"


# ------------------------------------------------------------------------------
# 3. SEGURIDAD DE CONSULTAS Y DATOS (HÍBRIDO / OPCIONAL)
# ------------------------------------------------------------------------------
# REQUIRE_AUTH:
#   - false (por defecto): Permite consultas abiertas a /api/view/* y /api/sp/*
#     (ideal para desarrollo local, intranet cerrada o retrocompatibilidad).
#   - true: Blinda la API en internet. Exige CUALQUIERA de las 3 opciones independientes:
#       Opción A: X-Admin-Key: <ADMIN_ACCESS_KEY>
#       Opción B: X-API-Key: <API_CLIENT_KEY> (para frontends sin login)
#       Opción C: Authorization: Bearer <token> (token obtenido en POST /api/auth/login)
#     (Nota: El Bearer token funciona SOLO; no requiere enviar API_CLIENT_KEY).
REQUIRE_AUTH=false

# Clave fija para frontends (Angular, React, Vue, Deno) que no usen login de usuarios:
API_CLIENT_KEY="<CLAVE_SECRETA_PARA_FRONTENDS>"

# Secreto criptográfico para firmar y validar tokens JWT (algoritmo HS256):
# Debe ser una cadena larga y aleatoria. Usado por POST /api/auth/login.
JWT_SECRET="<SECRETO_PARA_FIRMAR_Y_VERIFICAR_TOKENS_JWT>"


# ------------------------------------------------------------------------------
# 4. RESTRICCIÓN DE ORÍGENES CORS (OPCIONAL)
# ------------------------------------------------------------------------------
# Si se deja comentado o vacío, la API permite cualquier origen ('*').
# Si se definen dominios separados por coma, el navegador bloqueará cualquier otro sitio:
# CORS_WHITELIST="https://mi-portal.com,https://api-rpi.liqsysonline.com,http://localhost:5173"


# ------------------------------------------------------------------------------
# 5. PUERTO Y SERVIDOR WEB (OPCIONAL)
# ------------------------------------------------------------------------------
# Puerto HTTP donde escuchará la API (por defecto: 3005)
PORT=3005

# Host de escucha (por defecto 0.0.0.0 para escuchar en todas las interfaces)
# HOST=0.0.0.0


# ------------------------------------------------------------------------------
# 6. INSTANT CLIENT DE ORACLE (OPCIONAL)
# ------------------------------------------------------------------------------
# La API auto-detecta las librerías del sistema (/opt/oracle o C:\oracle).
# Descomentar únicamente si deseas forzar una ruta específica:
# ORACLE_CLIENT_LIB_DIR=./oracle-client/instantclient_23_3
