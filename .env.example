# ==============================================================================
# CONFIGURACIÓN ESENCIAL DE LA API (node-apiliq)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y ajusta los valores:
#   cp .env.example .env
# ==============================================================================

# 1. Conexión a Base de Datos Oracle (Obligatorio)
USERDB="US_SUELDO"
PASSWORD="tu_password_aqui"
# Formato: host:puerto/servicio (ej: 192.168.1.50:1521/desa)
CONNECTIONSTRING="192.168.1.50:1521/desa"

# 2. Seguridad Administrativa (Obligatorio)
# Protege endpoints críticos (/api/admin/*, /api/view/save, /api/import/*)
# Se envía vía cabecera: X-Admin-Key: <clave>
ADMIN_ACCESS_KEY="admin_liq_2026"

# 3. Servidor Web (Opcional, por defecto: 3005)
PORT=3005

# 4. Instant Client (Opcional: descomentar solo si las librerías están en una carpeta local)
# ORACLE_CLIENT_LIB_DIR=./oracle-client/instantclient_23_3
