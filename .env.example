# ==============================================================================
# API REST Sueldos (node-apiliq / api_liquid) - Configuración de Entorno (.env)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto y ajusta los valores:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONEXIÓN A BASE DE DATOS ORACLE (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Usuario o esquema de Oracle donde residen las tablas y paquetes de liquidación
USERDB=US_SUELDO

# Contraseña del usuario Oracle
PASSWORD=tu_contraseña_aqui

# Cadena de conexión TNS de Oracle. Formato: host:puerto/servicio
# Ejemplos: 192.168.1.50:1521/ORCL  ó  181.14.228.210:1521/desa
CONNECTIONSTRING=192.168.1.50:1521/ORCL

# Ruta al directorio de Oracle Instant Client (Basic / Basic Light)
# - Déjalo comentado si ya está instalado en el sistema operativo (/opt/oracle o Windows PATH).
# - Déjalo comentado si tu base de datos es Oracle 12c+ (funciona en modo Thin puro JavaScript).
# - Descomenta y define la ruta solo si usas Oracle 11g y tienes el cliente en una carpeta específica:
# ORACLE_CLIENT_LIB_DIR=./oracle-client/instantclient_23_3


# ------------------------------------------------------------------------------
# 2. SERVIDOR WEB Y PUERTO (OBLIGATORIO)
# ------------------------------------------------------------------------------
# Puerto único en el que escucha la API.
# En producción se mantiene este puerto interno (3005) y se coloca detrás de Nginx para SSL/HTTPS.
PORT=3005


# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y DEVELOPER & ADMIN STUDIO (RECOMENDADO)
# ------------------------------------------------------------------------------
# Clave maestra de administrador. Protege el ingreso a la consola visual (/admin),
# la recarga de memoria RAM (/view/refresh), el guardado de vistas (/view/save)
# y la carga masiva de archivos a tablas (/import/*).
# Si se envía vía API/curl, usar cabecera: X-Admin-Key: <clave>
ADMIN_ACCESS_KEY=admin_liq_2026

# Habilita o deshabilita la interfaz visual del Admin Studio en http://<host>:3005/admin
ENABLE_ADMIN_STUDIO=true


# ------------------------------------------------------------------------------
# 4. RENDIMIENTO Y POOL DE CONEXIONES ORACLE (OPCIONAL)
# ------------------------------------------------------------------------------
# Conexiones mínimas mantenidas abiertas en el pool (por defecto: 0)
DB_POOL_MIN=0

# Conexiones máximas simultáneas en el pool (por defecto: 10)
DB_POOL_MAX=10

# Tiempo máximo de espera en milisegundos para obtener una conexión del pool
# antes de cancelar la petición (por defecto: 10000 = 10 segundos).
# Evita que las peticiones se queden congeladas si la BD no responde.
DB_QUEUE_TIMEOUT=10000


# ------------------------------------------------------------------------------
# 5. CONTROL DE ACCESO CORS (OPCIONAL)
# ------------------------------------------------------------------------------
# Orígenes frontend permitidos para consumir la API, separados por comas.
# Si se deja vacío, se permite cualquier origen (*).
# Ejemplo: http://localhost:5173,https://sueldos.midominio.gob.ar
CORS_ORIGINS=


# ------------------------------------------------------------------------------
# 6. REPORTES Y RECIBOS EN PDF (OPCIONAL)
# ------------------------------------------------------------------------------
# Ruta al logo institucional en formato PNG o JPG que se estampa en las boletas PDF
LOGO_PATH=./assets/logo.png


# ------------------------------------------------------------------------------
# 7. USUARIOS Y TOKEN JWT (OPCIONAL)
# ------------------------------------------------------------------------------
# Clave secreta para la firma y verificación de tokens en el endpoint POST /api/adduser.
# Solo requerida si utilizas el endpoint de creación de usuarios.
JWT_SECRET=generar_un_secreto_largo_y_aleatorio_jwt


# ------------------------------------------------------------------------------
# 8. OPCIONES AVANZADAS (GENERALMENTE NO NECESARIAS)
# ------------------------------------------------------------------------------
# HTTPS Nativo en Node (solo si NO se utiliza Nginx/proxy inverso):
# ENABLE_HTTPS=false
# HTTPS_PORT=3007
# TLS_KEY_PATH=./certs/server.key
# TLS_CERT_PATH=./certs/server.crt

# Clave interna para peticiones del puente Deno:
# REQUIRE_INTERNAL_KEY=false
# API_INTERNAL_KEY=clave_secreta_interna